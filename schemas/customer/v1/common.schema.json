{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrm.local/schema/customer/v1/common.schema.json",
  "title": "NRM甲方接口公共定义",
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:@/-]+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "source": {"enum": ["CUSTOMER", "AFSIM", "NRM", "REPLAY"]},
    "networkType": {"enum": ["LINK11", "LINK16", "SATCOM", "CDL"]},
    "position": {
      "type": "object", "additionalProperties": false,
      "required": ["latitudeDeg", "longitudeDeg", "altitudeM"],
      "properties": {
        "latitudeDeg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitudeDeg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitudeM": {"type": "number"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"enum": ["INVALID_JSON", "SCHEMA_UNSUPPORTED", "SCHEMA_VALIDATION_FAILED", "REQUIRED_FIELD_MISSING", "VALUE_OUT_OF_RANGE", "REFERENCE_NOT_FOUND", "DUPLICATE_MESSAGE", "STALE_DATA", "DATA_INVALID", "INTERNAL_ERROR"]},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
