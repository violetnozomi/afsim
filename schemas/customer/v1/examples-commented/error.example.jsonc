{
  "schema": "nrm.customer.error.v1", // 固定值：统一错误 V1
  "messageId": "bad-001", // 关联失败输入的messageId
  "timestamp": "2026-08-17T10:00:01+08:00", // NRM生成的RFC 3339墙钟时间
  "source": "NRM", // 固定值：NRM
  "data": { // 以下字段均由NRM生成
    "success": false, // 固定值：false
    "errors": [ // 至少1项错误
      {
        "code": "REQUIRED_FIELD_MISSING", // 固定错误码枚举，详见error Schema
        "path": "/data/platformId", // JSON Pointer字段路径
        "message": "缺少平台编号" // 面向联调人员的简短说明
      }
    ]
  }
}

