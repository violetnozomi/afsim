{
  "schema": "nrm.customer.membership_request.v1", // 固定值：成员入退网请求 V1
  "messageId": "member-001", // 1~64字符；同一运行内唯一
  "timestamp": "2026-08-17T10:00:00+08:00", // RFC 3339墙钟时间
  "source": "CUSTOMER", // 固定值：CUSTOMER
  "data": { // 成员变更请求
    "requestId": "join-001", // 1~64字符；请求唯一编号
    "planId": "four-network-demo", // 已存在的资源规划编号
    "allocationId": "allocation-link16", // 规划内的分配编号
    "platformId": "l16_relay_1", // 申请入网或退网的平台编号
    "action": "JOIN" // JOIN入网；LEAVE退网
  }
}

