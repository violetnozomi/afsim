{
  "schema": "nrm.customer.provider_hello.v1", // 固定值：提供方能力声明 V1
  "messageId": "hello-001", // 1~64字符；会话内唯一
  "timestamp": "2026-08-17T10:00:00+08:00", // RFC 3339墙钟时间
  "source": "CUSTOMER", // 固定值：CUSTOMER
  "data": { // 甲方AFSIM模块能力声明
    "providerId": "customer-afsim-link-adapter", // 稳定模块编号；不要使用进程号
    "softwareVersion": "1.0.0", // 甲方模块版本字符串
    "supportedSchemas": [ // 本模块可提供的Schema固定值列表
      "nrm.customer.resource_report.v1", // 支持资源状态上报
      "nrm.customer.navigation_report.v1" // 支持导航状态上报
    ],
    "supportedNetworkTypes": [ // 可为空；仅填实际支持的网络
      "LINK11", // LINK11/LINK16/SATCOM/CDL
      "LINK16" // LINK11/LINK16/SATCOM/CDL
    ]
  }
}

