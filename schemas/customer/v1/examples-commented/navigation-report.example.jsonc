{
  "schema": "nrm.customer.navigation_report.v1", // 固定值：导航状态上报 V1
  "messageId": "nav-001", // 1~64字符；同一运行内唯一
  "timestamp": "2026-08-17T10:00:00+08:00", // RFC 3339墙钟时间
  "source": "CUSTOMER", // 固定值：CUSTOMER
  "data": { // 单平台单时刻导航样本
    "runId": "run-demo", // 1~64字符；一次仿真运行唯一
    "simTime": 10.0, // >=0，AFSIM仿真时间，单位s
    "platformId": "aircraft-01", // AFSIM平台唯一编号
    "navigationType": "INTEGRATED", // 允许值：GNSS/INS/INTEGRATED
    "truthPosition": { // AFSIM真实位置
      "latitudeDeg": 34.1, // -90~90，单位deg
      "longitudeDeg": 108.9, // -180~180，单位deg
      "altitudeM": 8000 // 高度，单位m
    },
    "perceivedPosition": { // 导航系统感知位置
      "latitudeDeg": 34.10001, // -90~90，单位deg
      "longitudeDeg": 108.89999, // -180~180，单位deg
      "altitudeM": 8002 // 感知高度，单位m
    },
    "positionErrorM": { // AFSIM导航误差分量
      "inTrack": 1.2, // 纵向误差，单位m
      "crossTrack": -0.8, // 横向误差，单位m
      "vertical": 2.0 // 垂向误差，单位m
    },
    "status": "GPS1", // PERFECT/GPS1/GPS2/GPS3或INSn
    "confidence": "HIGH" // 允许值：LOW/MEDIUM/HIGH
  }
}
