{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrm.local/schema/customer/v1/assessment-request.schema.json",
  "title": "任务评估请求",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "messageId",
    "timestamp",
    "source",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "nrm.customer.assessment_request.v1",
      "description": "固定值，表示任务评估请求V1。"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "description": "消息唯一编号；1～64字符，只允许字母、数字及_.:@/-。"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "消息生成墙钟时间，使用带时区的RFC 3339格式。"
    },
    "source": {
      "const": "CUSTOMER",
      "description": "固定值CUSTOMER，表示消息由甲方模块提供。"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "需要执行可达性和通信能力评估的任务约束。",
      "required": [
        "taskId",
        "sourcePlatformId",
        "destinationPlatformId",
        "businessType",
        "requiredBandwidthBps",
        "maximumDelayMs",
        "minimumPdrPercent",
        "allowedNetworks"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "description": "任务唯一编号；1～64字符。"
        },
        "sourcePlatformId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "description": "源平台编号，必须引用当前资源快照中的平台。"
        },
        "destinationPlatformId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "description": "目的平台编号，必须引用当前资源快照中的平台。"
        },
        "businessType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "业务类型；1～64字符，例如C2、TRACK或ISR_VIDEO。"
        },
        "requiredBandwidthBps": {
          "type": "number",
          "minimum": 0,
          "description": "业务所需最低带宽，必须大于等于0，单位bit/s。"
        },
        "maximumDelayMs": {
          "type": "number",
          "minimum": 0,
          "description": "业务允许的最大端到端时延，必须大于等于0，单位ms。"
        },
        "minimumPdrPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "业务要求的最低投递成功率，范围0～100，单位%。"
        },
        "allowedNetworks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "允许承载任务的网络类型，至少填写一项且不得重复。",
          "items": {
            "enum": [
              "LINK11",
              "LINK16",
              "SATCOM",
              "CDL"
            ],
            "description": "允许值为LINK11、LINK16、SATCOM或CDL。"
          }
        }
      }
    }
  }
}
