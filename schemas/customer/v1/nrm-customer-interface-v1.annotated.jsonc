          "networkType": "SATCOM",
          "modelType": "CUSTOMER_SATCOM_MODULE",
          "protocolDetails": {
            "type": "SATCOM",
            "relayPlatformIds": ["satellite-01"],
            // TRANSPARENT=透明转发，REGENERATIVE=再生转发，ABSTRACT=参数化近似。
            "transponderMode": "ABSTRACT",
            "uplinkBandHz": {"minimumHz": 7900000000, "maximumHz": 8400000000},
            "downlinkBandHz": {"minimumHz": 7250000000, "maximumHz": 7750000000}
          },
          "state": "ONLINE",
          "topologyType": "STAR",
          "memberEndpointIds": ["sat-terminal/satcom", "satellite-01/satcom"]
