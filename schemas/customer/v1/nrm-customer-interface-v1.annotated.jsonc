{
  // 中文注释版只供人工评审；正式交换请使用 examples 目录中的无注释JSON。
  "documentType": "NRM_CUSTOMER_INTERFACE_ANNOTATED_EXAMPLES_V1",
  "messages": [
    // 导航：真实位置、感知位置以及三轴误差。
    {"schema":"nrm.customer.navigation_report.v1","messageId":"nav-001","timestamp":"2026-08-13T10:00:00+08:00","source":"CUSTOMER","data":{"runId":"run-demo","simTime":10,"platformId":"aircraft-01","navigationType":"INTEGRATED","truthPosition":{"latitudeDeg":34.1,"longitudeDeg":108.9,"altitudeM":8000},"perceivedPosition":{"latitudeDeg":34.10001,"longitudeDeg":108.89999,"altitudeM":8002},"positionErrorM":{"inTrack":1.2,"crossTrack":-0.8,"vertical":2},"status":"GPS1","confidence":"HIGH"}},
    // 环境：只填写甲方能够提供的环境分项，applicationMode防止重复施加影响。
    {"schema":"nrm.customer.environment_report.v1","messageId":"env-001","timestamp":"2026-08-13T10:00:00+08:00","source":"CUSTOMER","data":{"runId":"run-demo","simTime":10,"regionId":"region-a","applicationMode":"INFORMATION_ONLY","weather":{"windSpeedMps":8,"rainRateMmPerHour":2.5,"cloudPercent":40}}},
    // 通信资源：完整快照，链路是单方向记录；未知指标直接省略。
    {"schema":"nrm.customer.resource_report.v1","messageId":"resource-001","timestamp":"2026-08-13T10:00:00+08:00","source":"CUSTOMER","data":{"runId":"run-demo","simTime":10,"networks":[{"networkId":"net-l16","networkType":"LINK16","name":"Link16演示网"}],"members":[{"memberId":"ep-1","platformId":"fighter-01","networkId":"net-l16","state":"ONLINE","position":{"latitudeDeg":34,"longitudeDeg":108.8,"altitudeM":8000}},{"memberId":"ep-2","platformId":"command-01","networkId":"net-l16","state":"ONLINE","position":{"latitudeDeg":34.2,"longitudeDeg":109,"altitudeM":0}}],"links":[{"linkId":"link-1","networkId":"net-l16","sourceMemberId":"ep-1","destinationMemberId":"ep-2","state":"ONLINE","bandwidthBps":238000,"delayMs":20,"pdrPercent":96}]}},
    // 任务评估请求：一个源、一个目的和三项基本约束。
    {"schema":"nrm.customer.assessment_request.v1","messageId":"assess-001","timestamp":"2026-08-13T10:00:00+08:00","source":"CUSTOMER","data":{"taskId":"task-001","sourcePlatformId":"fighter-01","destinationPlatformId":"command-01","businessType":"C2","requiredBandwidthBps":64000,"maximumDelayMs":300,"minimumPdrPercent":90,"allowedNetworks":["LINK16"]}},
    // 任务评估响应：只返回结论、路径、裕量和只读建议。
    {"schema":"nrm.customer.assessment_response.v1","messageId":"assess-001","timestamp":"2026-08-13T10:00:01+08:00","source":"NRM","data":{"taskId":"task-001","reachable":true,"canEstablish":true,"canComplete":true,"primaryRoute":["fighter-01","command-01"],"bandwidthMarginBps":174000,"delayMarginMs":280,"pdrMarginPercent":6,"reasonCodes":[],"recommendations":["保持当前Link-16直连路由"]}},
    // 资源规划：本例故意只放一个网络分配，四网完整样例见独立示例文件。
    {"schema":"nrm.customer.network_plan.v1","messageId":"plan-001","timestamp":"2026-08-13T10:00:00+08:00","source":"CUSTOMER","data":{"planId":"simple-plan","revision":1,"allocations":[{"allocationId":"a-l16","networkName":"nrm_link16","networkType":"LINK16","profileId":"demo-link16-v1","frequencyHz":1000000000,"channelId":"L16-DEMO","subnetId":"L16-A","members":["fighter-01","command-01"],"slots":["slot-001"],"routePolicyId":"shortest-stable","enabled":true}],"demands":[{"demandId":"d-1","businessType":"C2","sourcePlatformId":"fighter-01","destinationPlatformId":"command-01","payloadBits":8192,"requiredBandwidthBps":64000,"maximumDelayMs":300,"minimumPdrPercent":90,"allowedNetworks":["LINK16"]}]}},
    // 规划结果：校验、推演和状态；只有生成成功时才提供packagePath。
    {"schema":"nrm.customer.network_plan_result.v1","messageId":"plan-001","timestamp":"2026-08-13T10:00:01+08:00","source":"NRM","data":{"planId":"simple-plan","revision":1,"validationPassed":true,"evaluationStatus":"FAIL","state":"REJECTED","reasonCodes":["PDR_NOT_MET"],"recommendations":["改用PDR更高的备用链路或质量更好的中继路径。"]}},
    // 动态入网申请：成功处理后形成新的规划修订，不直接修改已校验版本。
    {"schema":"nrm.customer.membership_request.v1","messageId":"member-001","timestamp":"2026-08-13T10:00:00+08:00","source":"CUSTOMER","data":{"requestId":"join-001","planId":"simple-plan","allocationId":"a-l16","platformId":"relay-01","action":"JOIN"}},
    // 统一错误：path使用JSON Pointer，便于甲方直接定位字段。
    {"schema":"nrm.customer.error.v1","messageId":"bad-001","timestamp":"2026-08-13T10:00:01+08:00","source":"NRM","data":{"success":false,"errors":[{"code":"REQUIRED_FIELD_MISSING","path":"/data/platformId","message":"缺少平台编号"}]}}
  ]
}
