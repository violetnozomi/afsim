{
  // 本文件是供开发人员和甲方评审使用的 JSONC 中文注释版。
  // 它不是线上直接发送的单条报文；实际传输时从 messages 数组中取出一个对象发送。
  // 程序校验的唯一权威文件仍是 nrm-customer-interface-v1.schema.json。
  "documentType": "NRM_CUSTOMER_INTERFACE_ANNOTATED_EXAMPLES_V1",

  // 八类消息各给出一个可校验样例。标识、时间和数值均为演示值，不代表真实装备参数。
  "messages": [
    {
      // 1. 数据提供方连接后首先发送能力声明。
      "schemaVersion": "nrm.customer.provider_hello.v1",
      // 每条消息的唯一标识，用于日志关联和判重。
      "messageId": "hello-provider-annotated-001",
      // 数据提供模块的稳定标识，部署前由双方冻结。
      "providerId": "customer-communications-module",
      // 墙钟生成时间，仅用于运维追踪；算法不得把它当作仿真时间。
      "generatedAt": "2026-08-11T06:30:00Z",
      "adapterVersion": "1.0.0",
      // 提供方能够产生的消息结构版本。
      "supportedSchemas": [
        "nrm.customer.resource_report.v1",
        "nrm.customer.navigation_report.v1",
        "nrm.customer.environment_report.v1"
      ],
      // 当前模块能够上报的网络类型；缺少的类型可以不写。
      "supportedNetworkTypes": ["LINK11", "LINK16", "SATCOM", "CDL"],
      // V1 固定采用原子全量快照，暂不接受增量补丁。
      "reportMode": "FULL_SNAPSHOT",
      "minimumReportIntervalMs": 500,
      "maximumEndpoints": 1000,
      // 双方后续协商的非核心字段放在 extensions 中，不能改变现有字段语义。
      "extensions": {}
    },
    {
      // 2. 四网通信资源全量快照。
      "schemaVersion": "nrm.customer.resource_report.v1",
      "messageId": "resource-annotated-000125",
      "providerId": "customer-communications-module",
      // 一次 AFSIM 仿真运行的唯一标识；仿真重新开始后必须更换。
      "runId": "exercise-2026-001",
      // 同一 providerId/runId 内单调递增，用于丢弃乱序旧快照。
      "sequence": 125,
      // 提供方快照版本；NRM 接收后会在 ACK 中返回采用的版本。
      "snapshotVersion": 125,
      // AFSIM 仿真时间，单位秒，是评估算法的统一时间基准。
      "simTime": 62.5,
      "generatedAt": "2026-08-11T06:31:02.500Z",
      "fullSnapshot": true,
      "configVersion": "customer-network-config-7",

      // 网络清单。下面同时给出四类网络的协议专用字段。
      "networks": [
        {
          "networkId": "link11-net",
          "networkName": "Link11轮询网",
          "networkType": "LINK11",
          "modelType": "CUSTOMER_LINK11_MODULE",
          "protocolDetails": {
            "type": "LINK11",
            // 网络控制站端点标识。
            "netControlStationEndpointId": "l11-control/link11",
            // metric 中 valid=false 时不得用 value=0 冒充测量结果。
            "pollingCycleMs": {"value": 1200, "unit": "ms", "valid": true, "source": "CUSTOMER_MODULE", "confidence": "HIGH", "sampleTime": 62.5, "reasonCode": "NONE"},
            "replyTimeoutMs": {"value": 250, "unit": "ms", "valid": true, "source": "CUSTOMER_MODULE", "confidence": "HIGH", "sampleTime": 62.5, "reasonCode": "NONE"},
            "memberRoles": [
              {"endpointId": "l11-control/link11", "role": "NET_CONTROL_STATION"},
              {"endpointId": "l11-member/link11", "role": "PARTICIPANT"}
            ]
          },
          "state": "ONLINE",
          "topologyType": "STAR",
          "memberEndpointIds": ["l11-control/link11", "l11-member/link11"]
        },
        {
          "networkId": "link16-tactical",
          "networkName": "Link16战术网",
          "networkType": "LINK16",
          "modelType": "CUSTOMER_LINK16_MODULE",
          "protocolDetails": {
            "type": "LINK16",
            "netNumber": 7,
            // NPG 为网络参与组编号；具体允许值以后按甲方模块约束。
            "npgIds": [5, 7],
            // 无法提供真实终端细节时使用 ABSTRACT。
            "terminalMode": "ABSTRACT",
            // total/assigned/used 分别表示总时隙、已分配时隙和实际使用时隙。
            "slotAllocation": {"totalSlots": 1536, "assignedSlots": 96, "usedSlots": 61}
          },
          "state": "ONLINE",
          "topologyType": "MESH",
