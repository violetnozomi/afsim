          "headingDeg": {"value": 90, "unit": "deg", "valid": true, "source": "AFSIM_INTERNAL", "confidence": "HIGH", "sampleTime": 62.5, "reasonCode": "NONE"},
          "inTrackErrorM": {"value": 8, "unit": "m", "valid": true, "source": "AFSIM_INTERNAL", "confidence": "HIGH", "sampleTime": 62.5, "reasonCode": "NONE"},
          "crossTrackErrorM": {"value": 2, "unit": "m", "valid": true, "source": "AFSIM_INTERNAL", "confidence": "HIGH", "sampleTime": 62.5, "reasonCode": "NONE"},
          "verticalErrorM": {"value": 3, "unit": "m", "valid": true, "source": "AFSIM_INTERNAL", "confidence": "HIGH", "sampleTime": 62.5, "reasonCode": "NONE"},
