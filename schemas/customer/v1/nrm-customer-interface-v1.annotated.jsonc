          "state": "ONLINE",
          "topologyType": "POINT_TO_POINT",
          "memberEndpointIds": ["cdl-sensor/cdl", "cdl-station/cdl"]
        }
      ],

      // 通信端点是最小成员单位；同一平台可以有多个端点并加入不同网络。
      "endpoints": [
        {
          "endpointId": "fighter-01/link16",
          "platformId": "fighter-01",
          "platformName": "fighter-01",
          "memberNumber": "L16-101",
          "commName": "link16-terminal",
          "commType": "CUSTOMER_LINK16_TERMINAL",
          "networkId": "link16-tactical",
          "networkType": "LINK16",
          "address": "32.208.214.101",
          "state": "ONLINE",
          "canSend": true,
          "canReceive": true,
          // 统一使用 WGS-84 纬经高：纬度/经度为度，高度为米。
          "position": {"latitudeDeg": 35.2, "longitudeDeg": 119.8, "altitudeM": 6000, "coordinateSystem": "WGS84_LLA"},
          "supportedBusinessTypes": ["COMMAND_CONTROL", "SITUATION_AWARENESS"]
        }
      ],

      // 链路是有向的，反向链路必须使用另一个 linkId 单独上报。
      "links": [
        {
          "linkId": "fighter-01-link16--command-01-link16",
          "sourceEndpointId": "fighter-01/link16",
          "destinationEndpointId": "command-01/link16",
          "sourcePlatformId": "fighter-01",
          "destinationPlatformId": "command-01",
          "networkId": "link16-tactical",
          "networkType": "LINK16",
          "state": "ONLINE",
          // 链路加入/启用时间均为仿真秒，不冒充协议握手耗时。
          "linkAddedTime": 2.0,
          "linkEnabledTime": 2.2,
          "businessTypes": ["COMMAND_CONTROL", "SITUATION_AWARENESS"],
          "metrics": {
            "distanceM": {"value": 25340, "unit": "m", "valid": true, "source": "CUSTOMER_MODULE", "confidence": "HIGH", "sampleTime": 62.5, "window": 0, "reasonCode": "NONE"},
            "bandwidthBps": {"value": 1000000, "unit": "bit/s", "valid": true, "source": "CUSTOMER_MODULE", "confidence": "HIGH", "sampleTime": 62.5, "window": 0, "reasonCode": "NONE"},
            "oneWayDelayMs": {"value": 18.4, "unit": "ms", "valid": true, "source": "CUSTOMER_MODULE", "confidence": "MEDIUM", "sampleTime": 62.5, "window": 10, "reasonCode": "NONE"},
            "pdrPercent": {"value": 98.3, "unit": "percent", "valid": true, "source": "CUSTOMER_MODULE", "confidence": "HIGH", "sampleTime": 62.5, "window": 10, "reasonCode": "NONE"},
            // 甲方未提供 RSSI 时明确标为无效，不传 value，也不填假 0。
            "rssiDbm": {"unit": "dBm", "valid": false, "source": "CUSTOMER_MODULE", "confidence": "LOW", "sampleTime": 62.5, "window": 10, "reasonCode": "FIELD_NOT_PROVIDED"}
          },
          "messages": {"queued": 0, "transmitted": 60, "received": 59, "hops": 0, "discarded": 1, "routingFailed": 0, "queueDepth": 0}
        }
      ],
      // 跨网转发必须显式声明网关；空数组表示不允许跨网。
      "gatewayCapabilities": [],
      "routes": [
        {
          "routeId": "route-fighter-command",
          "sourcePlatformId": "fighter-01",
          "destinationPlatformId": "command-01",
          "endpointRoute": ["fighter-01/link16", "command-01/link16"],
          "networkSequence": ["LINK16"],
          "status": "ACTIVE",
