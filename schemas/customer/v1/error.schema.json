{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrm.local/schema/customer/v1/error.schema.json",
  "title": "统一错误响应",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "messageId", "timestamp", "source", "data"],
  "properties": {
    "schema": {"const": "nrm.customer.error.v1"}, "messageId": {"$ref": "common.schema.json#/$defs/identifier"}, "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"}, "source": {"const": "NRM"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "errors"],
      "properties": {
        "success": {"const": false},
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/error"}
        }
      }
    }
  }
}
