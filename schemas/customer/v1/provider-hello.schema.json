{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrm.local/schema/customer/v1/provider-hello.schema.json",
  "title": "资源提供方能力握手",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "messageId", "timestamp", "source", "data"],
  "properties": {
    "schema": {"const": "nrm.customer.provider_hello.v1"},
    "messageId": {"$ref": "common.schema.json#/$defs/identifier"},
    "timestamp": {"$ref": "common.schema.json#/$defs/timestamp"},
    "source": {"const": "CUSTOMER"},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["providerId", "softwareVersion", "supportedSchemas", "supportedNetworkTypes"],
      "properties": {
        "providerId": {"$ref": "common.schema.json#/$defs/identifier"},
        "softwareVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "supportedSchemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supportedNetworkTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/networkType"}}
      }
    }
  }
}
