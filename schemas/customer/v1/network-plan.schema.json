{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrm.local/schema/customer/v1/network-plan.schema.json",
  "title": "网链资源规划输入",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "messageId",
    "timestamp",
    "source",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "nrm.customer.network_plan.v1",
      "description": "固定值，表示网链资源规划输入V1。"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "description": "消息唯一编号；1～64字符，只允许字母、数字及_.:@/-。"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "消息生成墙钟时间，使用带时区的RFC 3339格式。"
    },
    "source": {
      "const": "CUSTOMER",
      "description": "固定值CUSTOMER，表示规划由甲方模块提供。"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "网络资源分配和需要在分配结果上并发推演的通信需求。",
      "required": [
        "planId",
        "revision",
        "allocations",
        "demands"
      ],
      "properties": {
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "description": "资源规划唯一编号；1～64字符。"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "同一规划的递增修订号，必须大于等于1。"
        },
        "planningDomain": {
          "enum": [
            "AIRBORNE",
            "GROUND",
            "JOINT"
          ],
          "description": "可选规划域；空中、地面或联合规划。"
        },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "description": "网络资源分配数组，至少包含一项。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "description": "一项网络、频率、信道、成员和路由策略分配。",
            "required": [
              "allocationId",
              "networkName",
              "networkType",
              "profileId",
              "frequencyHz",
              "channelId",
              "subnetId",
              "members",
              "routePolicyId",
              "enabled"
            ],
            "properties": {
              "allocationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "规划内唯一资源分配编号；1～64字符。"
              },
              "networkName": {
                "type": "string",
                "minLength": 1,
                "description": "目标AFSIM网络名称，不能为空。"
              },
              "networkType": {
                "enum": [
                  "LINK11",
                  "LINK16",
                  "SATCOM",
                  "CDL"
                ],
                "description": "网络类型；允许LINK11、LINK16、SATCOM或CDL。"
              },
              "profileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "插件中已配置的网络能力模板编号。"
              },
              "frequencyHz": {
                "type": "number",
                "minimum": 0,
                "description": "分配中心频率，必须大于等于0，单位Hz。"
              },
              "channelId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "分配信道、NPG或波束编号；1～64字符。"
              },
              "subnetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "分配子网编号；1～64字符。"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "参与本项分配的平台编号，至少一项且不得重复。",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$",
                  "description": "一个参与分配的AFSIM平台编号。"
                }
              },
              "slots": {
                "type": "array",
                "uniqueItems": true,
                "description": "可选轮询单元、时隙、波束或信道资源编号，不得重复。",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.:@/-]+$",
                  "description": "一个协议资源编号。"
                }
              },
              "routePolicyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "本项分配使用的路由策略编号。"
              },
              "enabled": {
                "type": "boolean",
                "description": "是否在规划推演中启用本项资源分配。"
              }
            }
          }
        },
        "demands": {
          "type": "array",
          "minItems": 1,
          "description": "需要在规划分配上并发验证的通信需求，至少一项。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "description": "一项规划内通信业务约束。",
            "required": [
              "demandId",
              "businessType",
              "sourcePlatformId",
              "destinationPlatformId",
              "payloadBits",
              "requiredBandwidthBps",
              "maximumDelayMs",
              "minimumPdrPercent",
              "allowedNetworks"
            ],
            "properties": {
              "demandId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "规划内唯一需求编号；1～64字符。"
              },
              "businessType": {
                "type": "string",
                "minLength": 1,
                "description": "业务类型，不能为空，例如C2、TRACK或ISR_VIDEO。"
              },
              "sourcePlatformId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "源平台编号，必须出现在规划或资源快照中。"
              },
              "destinationPlatformId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.:@/-]+$",
                "description": "目的平台编号，必须出现在规划或资源快照中。"
              },
              "payloadBits": {
                "type": "integer",
                "minimum": 0,
                "description": "本次业务载荷大小，必须为非负整数，单位bit。"
              },
              "requiredBandwidthBps": {
                "type": "number",
                "minimum": 0,
                "description": "业务所需最低带宽，必须大于等于0，单位bit/s。"
              },
              "maximumDelayMs": {
                "type": "number",
                "minimum": 0,
                "description": "业务允许最大端到端时延，必须大于等于0，单位ms。"
              },
              "minimumPdrPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "业务要求最低投递成功率，范围0～100，单位%。"
              },
              "allowedNetworks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "允许承载业务的网络类型，至少一项且不得重复。",
                "items": {
                  "enum": [
                    "LINK11",
                    "LINK16",
                    "SATCOM",
                    "CDL"
                  ],
                  "description": "允许值为LINK11、LINK16、SATCOM或CDL。"
                }
              }
            }
          }
        }
      }
    }
  }
}
