<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <LocalDebuggerCommand>@DEBUGGER_COMMAND@</LocalDebuggerCommand>
	<LocalDebuggerCommandArguments>@DEBUGGER_COMMAND_ARGS@</LocalDebuggerCommandArguments>
    <LocalDebuggerEnvironment>@DEBUG_ENVIRONMENT@</LocalDebuggerEnvironment>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <LocalDebuggerCommand>@DEBUGGER_COMMAND@</LocalDebuggerCommand>
	<LocalDebuggerCommandArguments>@DEBUGGER_COMMAND_ARGS@</LocalDebuggerCommandArguments>
    <LocalDebuggerEnvironment>@RELEASE_ENVIRONMENT@</LocalDebuggerEnvironment>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
</Project>
